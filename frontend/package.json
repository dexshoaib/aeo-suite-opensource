{
  "name": "aeo-suite-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "next dev",
