# AEO Suite — environment template (chunk 0.2)
# Copy to .env at the REPO ROOT and fill in real values.
# NEVER commit .env (gitignored). backend/config/settings reads it via django-environ.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CSRF (chunk 0.2, ADR-0005: dev = Next.js same-origin proxy) ---
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- PostgreSQL (local dev instance; ADR-0001: no Docker in development) ---
# The Task 11 runbook creates the least-privilege role (aeo_suite_user) and the
# aeo_suite database; until then the superuser default below works.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aeo_suite

# --- Redis ---
# NOT required in development for chunks 0.1-1.2 (ADR-0002: dev task queue =
# django.tasks DatabaseBackend on Postgres). Production uses Celery+Redis.
# REDIS_URL=redis://localhost:6379/0
