# AEO Suite — environment template
# Copy to .env at the REPO ROOT and fill in real values.
# NEVER commit .env (gitignored). The backend reads it via django-environ.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CSRF (frontend origins allowed to post forms) ---
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
# The backend README creates the least-privilege role (aeo, LOGIN +
# CREATEDB) and the aeo_suite database. Point DATABASE_URL at that role.
DATABASE_URL=postgres://aeo:change-me@localhost:5432/aeo_suite

# --- Redis ---
# Not required for local development (the development task queue runs on
# the database). Production uses Redis:
# REDIS_URL=redis://localhost:6379/0
