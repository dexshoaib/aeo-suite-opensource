# Platform built-in skills dir (not repo content) — anchored to repo root
# so it does NOT exclude .claude/skills/ (agent skills ARE repo content)
/skills/

# Python (backend, from chunk 0.2)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Node / Next.js (frontend, from chunk 0.3)
node_modules/
.next/
dist/

# Rust (crawler, from chunk 1.1)
target/

# Environment & secrets — never commit real values
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
Thumbs.db

# Local delivery staging (not repo content)
upload/
download/
.agents/
